{% set initialStyle = '' %}
{% if this.variables|length > 0 %}
	{% for name, value in this.variables %}
		{% set initialStyle = initialStyle ~ name ~ ": " ~ value ~ "; " %}
	{% endfor %}
{% elseif this.height > 0 %}
	{% set initialStyle = "--img-aspect: " ~ (this.width / this.height) ~ "; --img-width: " ~ this.width ~ "px;" %}
{% endif %}

{% set responsive = this.responsiveAttributes %}
<div {{ attributes.defaults(stimulus_controller(this.controller, {
	hash: this.hash,
	framework: this.framework
})).defaults({
	class:'progressive-image-container',
	style: initialStyle
}) }}
>
	<canvas
			{{ stimulus_target(this.controller,'placeholder') }}
			class="progressive-image-placeholder"
			title="{{ 'Loading...'|trans }}"
	></canvas>

	{% if this.hasResponsiveAttributes() and this.responsiveAttributes.sources|length > 0 %}
		<picture>
			{% for source in this.responsiveAttributes.sources %}
				<source
						{% if source.media %}media="{{ source.media }}"{% endif %}
						srcset="{{ source.srcset }}"
						sizes="{{ source.sizes }}"
				>
			{% endfor %}
			{{ block('img_tag') }}
		</picture>
	{% else %}
		{{ block('img_tag') }}
	{% endif %}

	{% if this.hash is null %}
		<div
				{{ stimulus_target(this.controller,'errorOverlay') }}
				class="progressive-image-error-overlay"
		>
			{% block error %}
				<div class="progressive-image-error-content">
					<div class="progressive-image-error-title">{{ "Oops! Something went wrong"|trans({},"progressive_image") }}</div>
					<p class="progressive-image-error-message">
						{{ 'This image decided to stay incognito. Maybe it’s still putting on makeup, or it just got lost in data hell.'|trans({},"progressive_image") }}
					</p>
				</div>
			{% endblock %}
		</div>
	{% endif %}
</div>

{% if false %}
	{% block img_tag %}
		<img
				{{ stimulus_target(this.controller,'highRes') }}
				class="progressive-image-high-res"
				alt="{{ this.alt }}"
				src="{{ asset(this.decoratedSrc) }}"
				{{ attributes.only('lazy') }}
				{{ attributes.only('fetchpriority') }}
				{{ stimulus_action(this.controller, 'reveal', 'load') | stimulus_action(this.controller, 'handleError', 'error') }}
				{% if this.hasResponsiveAttributes() %}
					srcset="{{ this.responsiveAttributes.defaultSource.srcset }}"
					sizes="{{ this.responsiveAttributes.defaultSource.sizes }}"
				{% endif %}
		>
	{% endblock %}
{% endif %}